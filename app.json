{
  "expo": {
    "name": "SmartThreat",
    "slug": "smart-threat",
    "version": "1.0.0",
    "scheme": "smartthreat",
    "orientation": "portrait",
    "backgroundColor": "#F5F7FD",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F7FD"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.smartthreat.app"
    },
    "android": {
      "package": "com.smartthreat.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5F7FD"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
